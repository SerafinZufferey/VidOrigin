{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "vidorigin",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostSubmit": "/internal/triggers/post-submit",
    "onPostUpdate": "/internal/triggers/post-update",
    "onPostDelete": "/internal/triggers/post-delete"
  },
  "permissions": {
  "reddit": true,
  "redis": true,
  "http": {
    "enable": true,
    "domains": [
      "identifying-functions-receiver-zip.trycloudflare.com",
      "wzfzpbaxrqdtmvspiss.supabase.co",
      "vidorigin-backend-production.up.railway.app"
    ]
  }
},
  "settings": {
    "global": {
      "backend-url": {
        "type": "string",
        "label": "vidOrigin backend URL"
      },
      "backend-secret": {
        "type": "string",
        "label": "Backend shared secret",
        "isSecret": true
      }
    }
  },
  "scripts": {
    "build": "npm run bundle"
  }
}
